# Copy this file to .env and fill in real values. Never commit .env.
# Every variable the app needs must be listed here with a dummy value.

# --- Backend (RAGdoll) ---
# URL of the RAGdoll API. Local: http://localhost:8000 (see RAGdoll's docker-compose.local.yml)
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:8000

# --- RAGdoll (server-only: no NEXT_PUBLIC_ prefix, so the access key never reaches the browser) ---
RAGDOLL_API_URL=https://iplvr.it.ntnu.no/backend
RAGDOLL_AGENT_ID=PASTE_AGENT_ID_HERE
RAGDOLL_ACCESS_KEY=PASTE_ACCESS_KEY_HERE

# --- Auth (Keycloak, provided by RAGdoll) ---
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=TODO
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=TODO

# --- Secrets ---
# The IDUN API key is used by RAGdoll, not by this frontend.
# It must never appear in this repository, not even here as a real value.

# TODO: review this list once the frontend stack is decided (Next.js vs React + Vite:
# the NEXT_PUBLIC_ prefix only applies to Next.js).
