# Copy this file to .env and fill in real values. Never commit .env.
# Every variable the app needs must be listed here with a dummy value.

# --- Backend (RAGdoll) ---
# URL of the RAGdoll that login, saving and listing agents talk to. Server-only.
# Local: http://localhost:8000 (see RAGdoll's docker-compose.local.yml)
BACKEND_API_URL=http://localhost:8000

# --- RAGdoll (server-only: no NEXT_PUBLIC_ prefix, so the access key never reaches the browser) ---
RAGDOLL_API_URL=https://iplvr.it.ntnu.no/backend
RAGDOLL_CONFIGURATOR_AGENT_ID=PASTE_AGENT_ID_HERE
RAGDOLL_CONFIGURATOR_ACCESS_KEY=PASTE_ACCESS_KEY_HERE
RAGDOLL_INTERVIEWER_AGENT_ID=PASTE_AGENT_ID_HERE
RAGDOLL_INTERVIEWER_ACCESS_KEY=PASTE_ACCESS_KEY_HERE

# --- Auth (Keycloak, provided by RAGdoll) ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=openssl rand -base64 32
KEYCLOAK_CLIENT_ID=ragdoll-config
KEYCLOAK_CLIENT_SECRET=ragdoll-config-secret   # local value from RAGdoll's realm JSON
KEYCLOAK_ISSUER=http://localhost:8080/realms/ragdoll

# --- IDUN (server-only) ---
# The project's IDUN key. Our server puts it into every agent it saves, as the agent's LLM key
# and embedding key, because counsellors have no key of their own. Ask the team for the value.
# Never commit the real key, not even here.
IDUN_API_KEY=PASTE_IDUN_KEY_HERE
